# Bot Configuration
BOT_TOKEN=your_discord_bot_token_here
COMMAND_PREFIX=!
SERENA_USER_ID=your_serena_user_id_here

# Database Configuration (modified for saltbox network PostgreSQL)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
DATABASE_MAX_CONNECTIONS=10
DATABASE_STATEMENT_TIMEOUT_MS=30000

# PostgreSQL Configuration (for existing saltbox PostgreSQL)
# Replace these with your actual PostgreSQL credentials from saltbox
POSTGRES_USER=username
POSTGRES_PASSWORD=password
POSTGRES_DB=database_name

# API Keys
OPENAI_API_KEY=your_openai_api_key_here
OPENWEATHER_API_KEY=your_openweather_api_key_here
API_NINJAS_KEY=your_api_ninjas_key_here
BFL_API_KEY=your_bfl_api_key_here

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_PATH=logs/bot.log
LOG_ROTATION_SIZE_MB=10
LOG_ROTATION_DAYS=7
LOG_FORMAT=text
LOG_TO_STDOUT=true
LOG_INCLUDE_THREAD_IDS=false
LOG_INCLUDE_THREAD_NAMES=false
LOG_INCLUDE_FILE_LINE=false

# Module-specific log levels
LOG_LEVEL_DATABASE=debug
LOG_LEVEL_API=info
LOG_LEVEL_COMMANDS=info

# Cache Configuration
CACHE_ENABLED=true
CACHE_MAX_SIZE=1000
CACHE_DEFAULT_TTL_SECS=300
CACHE_API_TTL_SECS=600
CACHE_WEATHER_TTL_SECS=1800
CACHE_OPENAI_TTL_SECS=86400
CACHE_GUILD_CONFIG_TTL_SECS=3600
CACHE_USER_DATA_TTL_SECS=1800
CACHE_API_ENABLED=true
CACHE_DB_ENABLED=true
