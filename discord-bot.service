[Unit]
Description=Discord Bot Docker Compose
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/path/to/discord-bot
# The script will use the appropriate docker-compose command
ExecStart=/bin/bash -c './deploy.sh'
ExecStop=/bin/bash -c 'if command -v docker-compose &> /dev/null; then docker-compose down; else docker compose down; fi'
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
