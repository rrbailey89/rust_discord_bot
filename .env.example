# Bot Configuration
BOT_TOKEN=your_discord_bot_token_here
COMMAND_PREFIX=!
SERENA_USER_ID=your_serena_user_id_here

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/database_name
DATABASE_MAX_CONNECTIONS=10
DATABASE_STATEMENT_TIMEOUT_MS=30000  # 30 seconds timeout for database statements

# API Keys
OPENAI_API_KEY=your_openai_api_key_here
OPENWEATHER_API_KEY=your_openweather_api_key_here
API_NINJAS_KEY=your_api_ninjas_key_here
BFL_API_KEY=your_bfl_api_key_here

# Logging Configuration
LOG_LEVEL=info                      # Global log level (trace, debug, info, warn, error)
LOG_FILE_PATH=logs/bot.log          # Path to log file (leave empty for stdout only)
LOG_ROTATION_SIZE_MB=10             # Size in MB for log rotation
LOG_ROTATION_DAYS=7                 # Number of days to keep rotated logs
LOG_FORMAT=text                     # Log format (text, json, compact)
LOG_TO_STDOUT=true                  # Whether to log to stdout in addition to file
LOG_INCLUDE_THREAD_IDS=false        # Include thread IDs in logs
LOG_INCLUDE_THREAD_NAMES=false      # Include thread names in logs
LOG_INCLUDE_FILE_LINE=false         # Include file and line information in logs

# Module-specific log levels (examples)
LOG_LEVEL_DATABASE=debug            # Debug level for database operations
LOG_LEVEL_API=info                  # Info level for API operations
LOG_LEVEL_COMMANDS=info             # Info level for command operations
