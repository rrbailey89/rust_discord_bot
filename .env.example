# Core Bot Configuration
BOT_TOKEN=your_discord_bot_token
APPLICATION_ID=your_discord_application_id
CDN_AVATAR_URL=https://cdn.discordapp.com/avatars
BOT_MODE=production
DEFAULT_PREFIX=!

# Database Configuration
DATABASE_URL=postgres://username:password@database:5432/botdb
DATABASE_MIN_CONNECTIONS=5
DATABASE_MAX_CONNECTIONS=20
DATABASE_ACQUIRE_TIMEOUT=30000
DATABASE_IDLE_TIMEOUT=10000

# Web Server Configuration
WEB_SERVER_PORT=3000
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
OAUTH_REDIRECT_URI=https://blameserena.rayplex.life/api/auth/discord/callback
JWT_SECRET=your_secure_jwt_secret_at_least_32_chars
JWT_EXPIRATION=86400

# Traefik Configuration
TRAEFIK_DOMAIN=blameserena.rayplex.life

# API Keys
OPENAI_API_KEY=your_openai_api_key_here
OPENWEATHER_API_KEY=your_openweather_api_key_here
API_NINJAS_KEY=your_api_ninjas_key_here
BFL_API_KEY=your_bfl_api_key_here

# Logging Configuration
RUST_LOG=info
LOG_FILE_PATH=/app/logs/bot.log
LOG_TO_STDOUT=true
LOG_LEVEL=info                      # Global log level (trace, debug, info, warn, error)
LOG_ROTATION_SIZE_MB=10             # Size in MB for log rotation
LOG_ROTATION_DAYS=7                 # Number of days to keep rotated logs
LOG_FORMAT=text                     # Log format (text, json, compact)
LOG_INCLUDE_THREAD_IDS=false        # Include thread IDs in logs
LOG_INCLUDE_THREAD_NAMES=false      # Include thread names in logs
LOG_INCLUDE_FILE_LINE=false         # Include file and line information in logs

# Module-specific log levels
LOG_LEVEL_DATABASE=debug            # Debug level for database operations
LOG_LEVEL_API=info                  # Info level for API operations
LOG_LEVEL_COMMANDS=info             # Info level for command operations

# Cache Configuration
CACHE_ENABLED=true                  # Enable/disable caching globally
CACHE_MAX_SIZE=1000                 # Maximum number of items in cache
CACHE_DEFAULT_TTL_SECS=300          # Default cache TTL (5 minutes)
CACHE_API_TTL_SECS=600              # API response cache TTL (10 minutes)
CACHE_WEATHER_TTL_SECS=1800         # Weather data cache TTL (30 minutes)
CACHE_OPENAI_TTL_SECS=86400         # OpenAI response cache TTL (24 hours)
CACHE_GUILD_CONFIG_TTL_SECS=3600    # Guild configuration cache TTL (1 hour)
CACHE_USER_DATA_TTL_SECS=1800       # User data cache TTL (30 minutes)
CACHE_API_ENABLED=true              # Enable/disable API response caching
CACHE_DB_ENABLED=true               # Enable/disable database query caching
